# Optional. The Flutter web app ships inside this site at public/app and /learn
# frames it same-origin, so a production deploy needs neither value. Set them
# only when the bundle is hosted somewhere else: both must be that exact origin,
# and a localhost value is ignored in a production build.
#
# Local development against `flutter run -d web-server --web-port 8080`:
NEXT_PUBLIC_LEARN_URL=http://localhost:8080

# Exact origin of the Flutter web build when it is served separately from this
# website. If unset, NEXT_PUBLIC_LEARN_URL supplies the origin.
FLUTTER_APP_ORIGIN=http://localhost:8080

# Managed Neon Auth. Generate a unique 32+ character cookie secret for each app environment.
NEON_AUTH_BASE_URL=https://YOUR_NEON_AUTH_URL.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Pooled Neon Postgres connection for server-side app queries.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Staff dashboard sign-in. The email is matched case-insensitively and the
# password is compared in constant time on the server. There is no demo mode.
ADMIN_EMAIL=support@skillbridge.tech
ADMIN_PASSWORD=replace-with-a-strong-password

# Random 32+ character secret used to sign the HttpOnly admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Cloudflare Worker that hosts the AI tutor (Workers AI). Server-side only:
# the browser and the app call this site's /api/tutor proxy instead, which forwards only the exact v1/tutor routes and checks FLUTTER_APP_ORIGIN.
# Example: https://skillbridge-tutor.YOUR_ACCOUNT.workers.dev
TUTOR_WORKER_URL=

# Optional service auth for server-side admin AI calls to the tutor worker.
# Set to "Bearer <TUTOR_SERVICE_KEY>" and configure the same TUTOR_SERVICE_KEY
# secret on the Cloudflare Worker. Never expose this to the browser.
TUTOR_SERVICE_AUTHORIZATION=
